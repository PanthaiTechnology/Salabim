# Backend (Python)
backend/.venv/
backend/__pycache__/
backend/**/__pycache__/
backend/.pytest_cache/
backend/.env
backend/*.egg-info/

# Mobile (Flutter) — build artifacts (android/ e ios/ SÃO versionados depois de gerados)
mobile/.dart_tool/
mobile/.flutter-plugins
mobile/.flutter-plugins-dependencies
mobile/.packages
mobile/build/
mobile/.idea/
mobile/*.iml
mobile/android/**/build/
mobile/android/.gradle/
mobile/android/local.properties
mobile/ios/Pods/
mobile/ios/.symlinks/
mobile/ios/Flutter/Flutter.framework
mobile/ios/Flutter/Flutter.podspec

# Keystore de release Android — NUNCA versionar. Perder isso impede
# atualizar o app depois de publicado; guarde backup fora do repositório
# (ver STORE_PUBLISHING.md secao 6).
mobile/android/key.properties
mobile/android/*.keystore
mobile/android/*.jks
mobile/*.keystore
mobile/*.jks

