# Copie este arquivo para .env e preencha com suas chaves reais.
# Nenhuma dessas contas pode ser criada automaticamente - veja ARCHITECTURE.md secao 9.

APP_ENV=development
APP_SECRET_KEY=troque-por-uma-chave-aleatoria-longa

# --- AudD (fingerprint de audio - modo "ouvir") ---
# https://audd.io
AUDD_API_TOKEN=

# --- ACRCloud (humming/singing - modo "cantarolar/assobiar") ---
# https://www.acrcloud.com -> crie um projeto do tipo "Humming"
ACRCLOUD_HOST=identify-eu-west-1.acrcloud.com
ACRCLOUD_ACCESS_KEY=
ACRCLOUD_ACCESS_SECRET=

# --- ACRCloud fingerprint "de musica" (Music Recognition - candidato a
# substituir a AudD no modo "ouvir") ---
# https://www.acrcloud.com -> crie um projeto do tipo "Audio & Video Recognition"
# (projeto DIFERENTE do de Humming acima, com sua propria chave)
ACRCLOUD_FINGERPRINT_HOST=identify-eu-west-1.acrcloud.com
ACRCLOUD_FINGERPRINT_ACCESS_KEY=
ACRCLOUD_FINGERPRINT_ACCESS_SECRET=
# audd | acrcloud - so muda pra "acrcloud" depois que as chaves acima
# estiverem preenchidas e voce quiser comparar os dois
LISTEN_RECOGNITION_PROVIDER=audd

# --- Odesli / song.link (links cross-platform) ---
# https://odesli.co - tier gratuito para baixo volume, nao exige chave para uso basico
ODESLI_API_KEY=

# --- Musixmatch (busca por letra) ---
# https://developer.musixmatch.com
MUSIXMATCH_API_KEY=

# --- Spotify (Client Credentials - reforca o link do Spotify quando o Odesli nao traz) ---
# https://developer.spotify.com/dashboard -> Create app -> Web API
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# --- Banco de dados ---
DATABASE_URL=postgresql+asyncpg://salabim:salabim@localhost:5432/salabim

# --- Redis (cache + rate limit) ---
REDIS_URL=redis://localhost:6379/0

# --- Armazenamento temporario de audio (S3-compativel, ex: Cloudflare R2) ---
S3_ENDPOINT_URL=
S3_BUCKET=salabim-audio-temp
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- CORS ---
ALLOWED_ORIGINS=*

# --- Distribuicao de APK de debug pra testers (opcional, so uso local/dev) ---
APK_DOWNLOADS_DIR=
